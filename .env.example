# ==========================================
# TaskFlow - Variables d'Environnement (Exemple)
# ==========================================

# Port d'écoute du serveur Node.js / Express (Render injecte automatiquement la variable PORT)
PORT=3000

# Mode d'exécution ('development' ou 'production')
NODE_ENV=development

# Clé secrète pour signer les jetons Bearer JWT (à générer de manière aléatoire en production)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_SECRET_KEY_32_CHARS"

# Durée de validité des tokens
JWT_EXPIRES_IN="7d"

# URL du service Backend (obligatoire si Frontend déployé sur Vercel et Backend sur Render)
# Exemple Render : https://taskflow-backend.onrender.com
VITE_API_URL=""

# Dossier de persistance locale de la base de données
DATABASE_DIR="./data"
